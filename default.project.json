{
  "name": "RbxenvV2Template",
  "tree": {
    "$className": "DataModel",
    "ReplicatedStorage": {
      "$className": "ReplicatedStorage",
            
      "TS": {                   
        "$path": "out" 
      },
      
      "Luau": {
        "$path": "src"
      },
      
      "rbxts_include": {
        "$path": "include",
        "node_modules": {
          "$className": "Folder",
          "@rbxts": {
            "$path": "node_modules/@rbxts"
          }
        }
      }
    }
  }
}